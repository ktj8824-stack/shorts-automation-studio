# 1. Google Gemini API 키 (무료 발급: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="여기에_발급받은_API_키를_넣어주세요"

# 기본 사용할 Gemini 모델 (무료 티어에서 빠르고 영상 분석이 가능한 모델)
GEMINI_MODEL="gemini-2.5-flash"
